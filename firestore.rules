rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the link can read and post match results, but only in the expected shape:
    // ids like "thu-1-2", winner h / p / a (halved), and a short margin such as "2&1".
    match /results/{matchId} {
      allow read: if true;
      allow delete: if matchId.matches('^(thu|fam|fpm)-[1-4]-[12]$');
      allow create, update: if matchId.matches('^(thu|fam|fpm)-[1-4]-[12]$')
        && request.resource.data.keys().hasOnly(['w', 'm'])
        && request.resource.data.w in ['h', 'p', 'a']
        && request.resource.data.m is string
        && request.resource.data.m.size() <= 12;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
