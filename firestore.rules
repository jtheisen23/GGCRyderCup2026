rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Tournament is over: results are read-only. The site shows the final
    // results frozen in index.html and no longer reads or writes here.
    match /results/{matchId} {
      allow read: if true;
      allow write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
